{
  "name": "desk-viewer",
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "ultracite": "7.9.4",
    "wxt": "^0.20.27"
  },
  "description": "A local-only Chrome extension for mirroring presentation sources.",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "biome check entrypoints wxt.config.ts",
    "postinstall": "wxt prepare",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "type": "module"
}
