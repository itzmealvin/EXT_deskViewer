{
  "name": "desk-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "A local-only Chrome extension for mirroring presentation sources.",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "check": "ultracite check",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "fix": "ultracite fix",
    "postinstall": "wxt prepare",
    "lint": "biome check entrypoints wxt.config.ts",
    "prepare": "husky",
    "test": "node --test tests/*.test.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "typescript": "~6.0.3",
    "ultracite": "8.0.1",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
